/*
Problem: Rotate List

Platform: LeetCode
Problem Link: https://leetcode.com/problems/rotate-list/

Difficulty: Medium

Concepts Used:
- Linked List
- Two Pointer
- Circular Linked List

Problem Statement:
Given the head of a linked list, rotate the list to the right by k places.

Approach:
1. Find the length of the linked list.
2. Connect the tail to the head to make it circular.
3. Reduce unnecessary rotations using:
      k = k % length
4. Find the new tail:
      newTail = length - k - 1
5. The node next to newTail becomes the new head.
6. Break the circular connection.

Time Complexity:
O(n)
- One traversal to calculate length
- One traversal to find new tail

Space Complexity:
O(1)
- No extra space used

Example:
Input:
head = [1,2,3,4,5], k = 2

Output:
[4,5,1,2,3]

Input:
head = [0,1,2], k = 4

Output:
[2,0,1]

Key Learning:
- Circular linked list concept
- Modulo optimization
- Pointer manipulation in linked lists
*/

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* rotateRight(ListNode* head, int k) {
        if(head == nullptr || head->next == nullptr) return head;
        ListNode* tail = head;

        //trverse till last, find the length of ll
        int l = 1;
        while(tail->next){
            tail = tail->next;
            l++;
        }
        k = k% l;
        //find the steps and make the ll circular
        int steps = l-k-1;
        tail->next = head;

        ListNode *tailHead = head;

        while(steps--){
            tailHead = tailHead->next;
        }

        ListNode * newHead = tailHead->next;
        tailHead->next = nullptr;

        return newHead;
    }
};
